# Cloudflare Email Service configuration for E2E tests
# Create an API token with the "Email Sending" permission at
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# Sender address on a domain onboarded to Cloudflare Email Sending
CLOUDFLARE_FROM=sender@yourdomain.com

# Recipient address (must be a verified destination until your domain is
# fully onboarded)
CLOUDFLARE_TO=you@example.com

# Optional: Custom API base URL
# CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
