{
  "workspace": [
    "packages/*"
  ],
  "imports": {
    "tsdown": "npm:tsdown@^0.12.7"
  },
  "nodeModulesDir": "none",
  "exclude": [
    "**/dist",
    "**/node_modules",
    ".agents",
    ".env",
    ".github",
    "coverage",
    "docs",
    "junit.xml",
    "node_modules",
    "tmp"
  ],
  "fmt": {
    "exclude": [
      "*.md",
      "**/*.md",
      "*.yaml",
      "**/*.yaml",
      "*.yml",
      "**/*.yml"
    ]
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ],
    "strict": true,
    "noImplicitOverride": true
  },
  "publish": {
    "exclude": [
      "**/tsconfig.json"
    ]
  }
}
