{
  "ensure_final_newline_on_save": true,
  "format_on_save": "on",
  "formatter": "language_server",
  "languages": {
    "JavaScript": {
      "language_servers": [
        "vtsls",
        "oxlint",
        "oxfmt",
        "!deno",
        "!typescript-language-server",
        "!eslint",
        "!biome",
        "..."
      ],
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ],
      "prettier": {
        "allowed": false
      }
    },
    "JSON": {
      "language_servers": ["json-language-server", "oxfmt", "..."],
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSONC": {
      "language_servers": ["json-language-server", "oxfmt", "..."],
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TypeScript": {
      "language_servers": [
        "vtsls",
        "oxlint",
        "oxfmt",
        "!deno",
        "!typescript-language-server",
        "!eslint",
        "!biome",
        "..."
      ],
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ],
      "prettier": {
        "allowed": false
      }
    },
    "TSX": {
      "language_servers": [
        "vtsls",
        "oxlint",
        "oxfmt",
        "!deno",
        "!typescript-language-server",
        "!eslint",
        "!biome",
        "..."
      ],
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ],
      "prettier": {
        "allowed": false
      }
    },
    "YAML": {
      "language_servers": ["!yaml-language-server", "!eslint", "!biome", "..."]
    }
  },
  "show_wrap_guides": true,
  "wrap_guides": [80]
}
